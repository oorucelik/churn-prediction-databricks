FROM apache/airflow:2.10.4-python3.11

RUN pip install --upgrade pip

# Layer 1: Install dbt-databricks (pulls connector 3.6.x)
RUN pip install --no-cache-dir "dbt-databricks==1.9.4"

# Layer 2: Install Airflow providers + cosmos.
# --no-deps on providers-databricks to avoid it downgrading connector.
# The provider works fine with connector 3.6 at runtime — the <3.0 pin
# is overly conservative.
RUN pip install --no-cache-dir \
    "astronomer-cosmos==1.8.1" \
    "apache-airflow-providers-docker==3.14.0" \
    "apache-airflow-providers-databricks==6.3.0" --no-deps

# Layer 3: Install providers-databricks deps that --no-deps skipped
# (minus databricks-sql-connector which is already satisfied by layer 1)
# Layer 3: Install deps that --no-deps skipped
RUN pip install --no-cache-dir "aiohttp>=3.9.2,<4" "aenum" "msgpack"
